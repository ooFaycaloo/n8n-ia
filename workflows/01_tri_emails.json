    {
      "id": "82201850-269c-585b-9a23-1b4b37dcbc5c",
      "name": "Classer l'email",
      "type": "@n8n/n8n-nodes-langchain.textClassifier",
      "typeVersion": 1.1,
      "position": [
        460,
        0
      ],
      "parameters": {
        "inputText": "=Objet : {{ $json.subject }}\nDe : {{ $json.from.text }}\n\n{{ ($json.text || '').slice(0, 4000) }}",
        "categories": {
          "categories": [
            {
              "category": "Devis ou commande",
              "description": "Demande de prix, de devis, de disponibilité ou passage de commande"
            },
            {
              "category": "Réclamation",
              "description": "Mécontentement, litige, produit défectueux, retard, demande de remboursement"
            },
            {
              "category": "Facture ou comptabilité",
              "description": "Facture, relance de paiement, avoir, question comptable"
            },
            {
              "category": "Support technique",
              "description": "Problème d'utilisation, panne, question technique sur un produit ou service"
            },
            {
              "category": "Prospection ou spam",
              "description": "Démarchage commercial, newsletter, message automatique, spam"
            }
          ]
        },
        "options": {
          "fallback": "other",
          "systemPromptTemplate": "Classe l'email d'un client dans l'une des catégories suivantes : {categories}. Suis les instructions de format ci-dessous. N'explique pas, réponds uniquement en JSON."
        }
      }
    },
